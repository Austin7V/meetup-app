
import { useState } from "react";
import {
  SafeAreaView,
  ScrollView,
  View,
  Text,
  TextInput,
  Pressable,
  StyleSheet,
  StatusBar,
  Modal,
  Platform,
  Keyboard,
} from "react-native";

import DateTimePicker from "@react-native-community/datetimepicker";

// RU: Поддерживаемые языки.
// DE: Unterstützte Sprachen.
type Language = "ru" | "de" | "en";

// RU: Постоянные ID категорий.
// DE: Feste Kategorie-IDs.
type Category =
    | "games"
    | "movies"
    | "chat"
    | "bars"
    | "parties"
    | "walking"
    | "dating";

const categories: { id: Category; icon: string }[] = [
  { id: "games", icon: "🎮" },
  { id: "movies", icon: "🎬" },
  { id: "chat", icon: "💬" },
  { id: "bars", icon: "🍸" },
  { id: "parties", icon: "🎉" },
  { id: "walking", icon: "🚶" },
  { id: "dating", icon: "❤️" },
];

const locales: Record<Language, string> = {
  ru: "ru-RU",
  de: "de-DE",
  en: "en-US",
};

// RU: Переводы интерфейса.
// DE: Übersetzungen der Benutzeroberfläche.
const translations = {
  ru: {
    title: "Создай свой профиль",
    subtitle: "Найди людей, которые разделяют твои интересы.",
    nickname: "Никнейм",
    birthday: "Дата рождения",
    interests: "Что тебе интересно?",
    multiple: "Можно выбрать несколько",
    about: "Расскажи о себе (необязательно)",
    save: "Продолжить",
    cancel: "Отмена",
    done: "Готово",
    welcome: "Привет",
    ready: "Твой профиль готов!",
    search: "Скоро здесь появится поиск людей.",
    edit: "Изменить профиль",
    categories: {
      games: "Игры",
      movies: "Кино",
      chat: "Общение",
      bars: "Бары",
      parties: "Вечеринки",
      walking: "Прогулки",
      dating: "Знакомства",
    },
  },
  de: {
    title: "Erstelle dein Profil",
    subtitle: "Finde Menschen mit ähnlichen Interessen.",
    nickname: "Benutzername",
    birthday: "Geburtsdatum",
    interests: "Was interessiert dich?",
    multiple: "Mehrfachauswahl möglich",
    about: "Erzähl etwas über dich (optional)",
    save: "Weiter",
    cancel: "Abbrechen",
    done: "Fertig",
    welcome: "Hallo",
    ready: "Dein Profil ist fertig!",
    search: "Hier erscheint bald die Personensuche.",
    edit: "Profil bearbeiten",
    categories: {
      games: "Gaming",
      movies: "Kino",
      chat: "Unterhaltung",
      bars: "Bars",
      parties: "Partys",
      walking: "Spazieren",
      dating: "Dating",
    },
  },
  en: {
    title: "Create your profile",
    subtitle: "Find people who share your interests.",
    nickname: "Nickname",
    birthday: "Date of birth",
    interests: "What are you into?",
    multiple: "Select multiple interests",
    about: "Tell us about yourself (optional)",
    save: "Continue",
    cancel: "Cancel",
    done: "Done",
    welcome: "Hello",
    ready: "Your profile is ready!",
    search: "People discovery is coming soon.",
    edit: "Edit profile",
    categories: {
      games: "Gaming",
      movies: "Movies",
      chat: "Chat",
      bars: "Bars",
      parties: "Parties",
      walking: "Walking",
      dating: "Dating",
    },
  },
};

// RU: Вычисляем возраст по дате рождения.
// DE: Alter anhand des Geburtsdatums berechnen.
function calculateAge(date: Date): number {
  const today = new Date();
  let age = today.getFullYear() - date.getFullYear();

  const monthDifference = today.getMonth() - date.getMonth();

  if (
      monthDifference < 0 ||
      (monthDifference === 0 && today.getDate() < date.getDate())
  ) {
    age--;
  }

  return age;
}

export default function App() {
  const [language, setLanguage] = useState<Language>("ru");
  const t = translations[language];

  // RU: Данные профиля.
  // DE: Profildaten.
  const [nickname, setNickname] = useState("");
  const [birthDate, setBirthDate] = useState<Date | null>(null);
  const [about, setAbout] = useState("");
  const [interests, setInterests] = useState<Category[]>([]);
  const [profileSaved, setProfileSaved] = useState(false);

  // RU: Управление календарём.
  // DE: Steuerung der Datumsauswahl.
  const [showDatePicker, setShowDatePicker] = useState(false);
  const [draftDate, setDraftDate] = useState(new Date(2000, 0, 1));

  // RU: Максимальная дата рождения для возраста 18+.
  // DE: Spätestes Geburtsdatum für Personen ab 18.
  const today = new Date();
  const maxBirthDate = new Date(
      today.getFullYear() - 18,
      today.getMonth(),
      today.getDate()
  );

  function toggleInterest(id: Category) {
    setInterests((current) =>
        current.includes(id)
            ? current.filter((item) => item !== id)
            : [...current, id]
    );
  }

  function openDatePicker() {
    Keyboard.dismiss();
    setDraftDate(birthDate ?? new Date(2000, 0, 1));
    setShowDatePicker(true);
  }

  function confirmDate() {
    setBirthDate(draftDate);
    setShowDatePicker(false);
  }

  // RU: Проверяем обязательные данные.
  // DE: Pflichtangaben prüfen.
  const canSave =
      nickname.trim().length >= 2 &&
      birthDate !== null &&
      calculateAge(birthDate ?? today) >= 18 &&
      interests.length > 0;

  return (
      <SafeAreaView style={styles.screen}>
        <StatusBar barStyle="dark-content" />

        <ScrollView
            contentContainerStyle={styles.container}
            keyboardShouldPersistTaps="handled"
            showsVerticalScrollIndicator={false}
        >
          {/* RU: Переключатель языка. DE: Sprachauswahl. */}
          <View style={styles.languages}>
            <Text style={styles.brand}>MEETUP</Text>

            <View style={styles.languageButtons}>
              {(["ru", "de", "en"] as const).map((lang) => (
                  <Pressable
                      key={lang}
                      onPress={() => setLanguage(lang)}
                      style={[
                        styles.languageButton,
                        language === lang && styles.languageActive,
                      ]}
                  >
                    <Text
                        style={[
                          styles.languageText,
                          language === lang && styles.languageTextActive,
                        ]}
                    >
                      {lang.toUpperCase()}
                    </Text>
                  </Pressable>
              ))}
            </View>
          </View>

          {!profileSaved ? (
              <>
                <Text style={styles.title}>{t.title}</Text>
                <Text style={styles.subtitle}>{t.subtitle}</Text>

                {/* RU: Никнейм. DE: Benutzername. */}
                <TextInput
                    style={styles.input}
                    placeholder={t.nickname}
                    placeholderTextColor="#8290A5"
                    value={nickname}
                    onChangeText={setNickname}
                    maxLength={30}
                    autoCapitalize="words"
                />

                {/* RU: Дата рождения. DE: Geburtsdatum. */}
                <Pressable style={styles.input} onPress={openDatePicker}>
                  <Text
                      style={[
                        styles.dateText,
                        !birthDate && styles.placeholder,
                      ]}
                  >
                    {birthDate
                        ? birthDate.toLocaleDateString(locales[language])
                        : t.birthday}
                  </Text>
                </Pressable>

                {/* RU: Выбор интересов. DE: Interessen wählen. */}
                <View style={styles.sectionHeader}>
                  <Text style={styles.sectionTitle}>{t.interests}</Text>
                  <Text style={styles.sectionHint}>{t.multiple}</Text>
                </View>

                <View style={styles.categories}>
                  {categories.map((category) => {
                    const selected = interests.includes(category.id);

                    return (
                        <Pressable
                            key={category.id}
                            onPress={() => toggleInterest(category.id)}
                            style={[
                              styles.category,
                              selected && styles.categorySelected,
                            ]}
                        >
                          <Text
                              style={[
                                styles.categoryText,
                                selected && styles.categoryTextSelected,
                              ]}
                          >
                            {category.icon} {t.categories[category.id]}
                          </Text>
                        </Pressable>
                    );
                  })}
                </View>

                {/* RU: Необязательное описание. DE: Optionale Beschreibung. */}
                <TextInput
                    style={[styles.input, styles.aboutInput]}
                    placeholder={t.about}
                    placeholderTextColor="#8290A5"
                    multiline
                    maxLength={300}
                    value={about}
                    onChangeText={setAbout}
                    textAlignVertical="top"
                />

                {/* RU: Продолжить. DE: Weiter. */}
                <Pressable
                    disabled={!canSave}
                    onPress={() => setProfileSaved(true)}
                    style={[
                      styles.button,
                      !canSave && styles.buttonDisabled,
                    ]}
                >
                  <Text style={styles.buttonText}>{t.save} →</Text>
                </Pressable>
              </>
          ) : (
              <>
                <Text style={styles.title}>
                  {t.welcome}, {nickname}! 👋
                </Text>

                <Text style={styles.subtitle}>{t.ready}</Text>

                <Text style={styles.ageText}>
                  {birthDate ? `${calculateAge(birthDate)} 🎂` : ""}
                </Text>

                <View style={styles.categories}>
                  {interests.map((id) => (
                      <View key={id} style={styles.categorySelected}>
                        <Text style={styles.categoryTextSelected}>
                          {categories.find((item) => item.id === id)?.icon}{" "}
                          {t.categories[id]}
                        </Text>
                      </View>
                  ))}
                </View>

                <Text style={styles.subtitle}>{t.search}</Text>

                <Pressable
                    style={styles.button}
                    onPress={() => setProfileSaved(false)}
                >
                  <Text style={styles.buttonText}>{t.edit}</Text>
                </Pressable>
              </>
          )}
        </ScrollView>

        {/* RU: Системный календарь Android.
          DE: Nativer Android-Datumsdialog. */}
        {Platform.OS === "android" && showDatePicker && (
            <DateTimePicker
                value={birthDate ?? new Date(2000, 0, 1)}
                mode="date"
                maximumDate={maxBirthDate}
                minimumDate={new Date(1900, 0, 1)}
                onChange={(event, selectedDate) => {
                  setShowDatePicker(false);

                  if (event.type === "set" && selectedDate) {
                    setBirthDate(selectedDate);
                  }
                }}
            />
        )}

        {/* RU: Колесо выбора даты для iPhone.
          DE: Datums-Auswahlrad für iPhone. */}
        {Platform.OS === "ios" && (
            <Modal
                visible={showDatePicker}
                transparent
                animationType="slide"
                onRequestClose={() => setShowDatePicker(false)}
            >
              <View style={styles.modalOverlay}>
                <View style={styles.modalContent}>
                  <View style={styles.modalHeader}>
                    <Pressable onPress={() => setShowDatePicker(false)}>
                      <Text style={styles.modalAction}>{t.cancel}</Text>
                    </Pressable>

                    <Pressable onPress={confirmDate}>
                      <Text style={styles.modalAction}>{t.done}</Text>
                    </Pressable>
                  </View>

                  <DateTimePicker
                      value={draftDate}
                      mode="date"
                      display="spinner"
                      locale={locales[language]}
                      minimumDate={new Date(1900, 0, 1)}
                      maximumDate={maxBirthDate}
                      onChange={(_, selectedDate) => {
                        if (selectedDate) {
                          setDraftDate(selectedDate);
                        }
                      }}
                      style={styles.datePicker}
                  />
                </View>
              </View>
            </Modal>
        )}
      </SafeAreaView>
  );
}

